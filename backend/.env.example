NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/support_ticket_db?retryWrites=true&w=majority

# JWT configuration (use a strong random 32+ character string in production)
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Cookie & CORS configuration
COOKIE_NAME=auth_token
CSRF_COOKIE_NAME=csrf_token
CORS_ORIGIN=http://localhost:5173

# Rate limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300

# Optional Admin Seed / Bootstrap (never enable public admin registration)
ADMIN_SEED_NAME=System Administrator
ADMIN_SEED_EMAIL=admin@helpdesk.local
ADMIN_SEED_PASSWORD=ChangeMeStrongPassword123!
ENABLE_ADMIN_BOOTSTRAP=false
